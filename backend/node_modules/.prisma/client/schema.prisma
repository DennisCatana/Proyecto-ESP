generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────
enum RolNombre {
  Administrador
  Instructor
  Cadete
  Servicio
}

enum TipoAccion {
  Positiva
  Negativa
}

// ─── TABLA CENTRAL DE LOGIN ───────────────────────────
model Usuario {
  id                      Int       @id @default(autoincrement())
  correo                  String    @unique
  password                String
  rol                     RolNombre
  activo                  Boolean   @default(true)
  cambioPassword          Boolean   @default(true)
  tokenSession            String?
  tokenVerificacion       String?
  tokenRecuperacion       String?
  tokenRecuperacionExpira DateTime?
  confirmarCorreo         Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relaciones — solo UNA tendrá valor según el rol
  cadete        Cadete?        @relation("UsuarioCadete")
  instructor    Instructor?    @relation("UsuarioInstructor")
  administrador Administrador? @relation("UsuarioAdministrador")

  accionesRegistradas Accion[] @relation("AccionesRegistradas")

  @@index([rol])
  @@index([correo])
}

// ─── PERFIL: CADETES ──────────────────────────────────
model Cadete {
  id                Int       @id @default(autoincrement())
  usuarioId         Int       @unique
  promocion         String
  cia               String
  nombre            String
  cedula            String    @unique
  seccion           String
  genero            String?
  habitacion        String?
  edad              String?
  grupo_guardia     String?
  antiguedad        Int?
  correo            String?
  telefono          String?
  fecha_nacimiento  DateTime?
  seguro_medico     String?
  numero_emergencia String?
  parentesco        String?
  lugar_nacimiento  String?
  lugar_residencia  String?
  estado            Boolean   @default(true)
  puntajeTotal      Decimal   @default(0) @db.Decimal(7, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  usuario  Usuario  @relation("UsuarioCadete", fields: [usuarioId], references: [id], onDelete: Cascade)
  acciones Accion[]

  @@index([cedula])
  @@index([promocion])
  @@index([estado])
}

// ─── PERFIL: INSTRUCTORES ─────────────────────────────
model Instructor {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @unique
  nombre       String
  cedula       String   @unique
  telefono     String?
  especialidad String?
  grado        String?
  estado       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usuario Usuario @relation("UsuarioInstructor", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([cedula])
  @@index([estado])
}

// ─── PERFIL: ADMINISTRADORES ──────────────────────────
model Administrador {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique
  nombre    String
  estado    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation("UsuarioAdministrador", fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ─── ACCIONES Y DEFINIDAS ─────────────────────────────
model Accion {
  id               Int      @id @default(autoincrement())
  cadeteId         Int
  accionDefinidaId Int
  registradoPorId  Int
  observacion      String?
  puntajeAplicado  Decimal  @db.Decimal(5, 2)
  puntajeAcumulado Decimal  @db.Decimal(7, 2)
  ruta_imagen      String?
  fecha            DateTime @default(now())
  dia              Int?
  fechaRegistro    DateTime @default(now())

  accionDefinida AccionDefinida @relation(fields: [accionDefinidaId], references: [id])
  cadete         Cadete         @relation(fields: [cadeteId], references: [id], onDelete: Cascade)
  registradoPor  Usuario        @relation("AccionesRegistradas", fields: [registradoPorId], references: [id])

  @@index([cadeteId])
  @@index([accionDefinidaId])
  @@index([registradoPorId])
  @@index([fecha])
}

model AccionDefinida {
  id          Int        @id @default(autoincrement())
  codigo      String     @unique
  titulo      String
  descripcion String
  tipo        TipoAccion
  puntaje     Float
  activa      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  accionesAplicadas Accion[]

  @@index([tipo])
  @@index([activa])
}
