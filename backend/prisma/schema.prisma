generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                      Int       @id @default(autoincrement())
  cedula                  String    @unique
  gradoU                  String    
  nombreU                 String    @unique
  correoU                 String    @unique
  passwordU               String
  activo                  Boolean   @default(true)
  cambioPassword          Boolean   @default(true)
  tokenSession            String?
  tokenVerificacion       String?
  tokenRecuperacion       String?
  tokenRecuperacionExpira DateTime?
  confirmarCorreo         Boolean   @default(false)
  rol                     RolNombre
  cadeteId                Int?      @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  accionesRegistradas     Accion[]  @relation("AccionesRegistradas")
  cadete                  Cadete?   @relation(fields: [cadeteId], references: [id])

  @@index([rol])
  @@index([cedula])
}

model Cadete {
  id                Int       @id @default(autoincrement())
  promocion         String
  cia               String
  nombre            String
  cedula            String    @unique
  seccion           String
  genero            String?
  habitacion        String?
  grupo_guardia     String?
  antiguedad        Int?
  correo            String?
  telefono          String?
  fecha_nacimiento  DateTime?
  seguro_medico     String?
  numero_emergencia String?
  parentesco        String?
  lugar_nacimiento  String?
  lugar_residencia  String?
  estado            Boolean   @default(true)
  puntajeTotal      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  acciones          Accion[]
  usuario           Usuario?

  @@index([cedula])
  @@index([promocion])
  @@index([estado])
}

model Accion {
  id               Int            @id @default(autoincrement())
  cadeteId         Int
  accionDefinidaId Int
  registradoPorId  Int
  observacion      String?
  puntajeAplicado  Decimal        @db.Decimal(5, 2)
  puntajeAcumulado Decimal        @db.Decimal(7, 2)
  ruta_imagen      String?
  fecha            DateTime       @default(now())
  accionDefinida   AccionDefinida @relation(fields: [accionDefinidaId], references: [id])
  cadete           Cadete         @relation(fields: [cadeteId], references: [id], onDelete: Cascade)
  registradoPor    Usuario        @relation("AccionesRegistradas", fields: [registradoPorId], references: [id])

  @@index([cadeteId])
  @@index([accionDefinidaId])
  @@index([registradoPorId])
  @@index([fecha])
}

model AccionDefinida {
  id                Int        @id @default(autoincrement())
  codigo            String     @unique
  titulo            String
  descripcion       String
  tipo              TipoAccion
  puntaje           Float
  activa            Boolean    @default(true)
  createdAt         DateTime   @default(now())
  accionesAplicadas Accion[]

  @@index([tipo])
  @@index([activa])
}

enum RolNombre {
  Administrador
  Instructor
  Servicio
  Alumno
}

enum TipoAccion {
  Positiva
  Negativa
}
