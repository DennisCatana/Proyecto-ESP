# Copia este contenido a tu archivo .env y configura tus credenciales

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombredb"

# URL del frontend
URL_FRONTEND=http://localhost:5173

# Configuración de Gmail para envío de correos
# IMPORTANTE: Necesitas usar una contraseña de aplicación de Google
# Ve a: https://myaccount.google.com/apppasswords
USER_MAILTRAP=tu_correo@gmail.com
PASS_MAILTRAP=tu_contraseña_de_aplicación
HOST_MAILTRAP=smtp.gmail.com
PORT_MAILTRAP=587

# Configuración alternativa (Mailtrap para pruebas)
# USER_MAILTRAP=tu_correo@mailtrap.io
# PASS_MAILTRAP=tu_api_key
# HOST_MAILTRAP=smtp.mailtrap.io
# PORT_MAILTRAP=2525

